<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1928e720-d856-4fdb-9791-bd6419326aa1</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;publish\**;artifacts\**;.tmp_build\**;obj_codex\**;obj_codex2\**;obj_tmp\**;bin_codex\**;bin_codex2\**;bin_tmp\**;Server\**;Server.Tests\**;**\publish\**;**\artifacts\**;**\.tmp_build\**;**\obj_codex\**;**\obj_codex2\**;**\obj_tmp\**;**\bin_codex\**;**\bin_codex2\**;**\bin_tmp\**;**\Server\**;**\Server.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShadowverseBeyond.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scrutor" Version="6.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <!-- Exclude test files accidentally placed in the main project -->
  <ItemGroup>
    <Compile Remove="Domain\Abilities\DSL\Functions\Tests\**\*.cs" />
    <None Include="Domain\Abilities\DSL\Functions\Tests\**\*.cs" />
  </ItemGroup>

  <!-- Guard against accidentally compiling generated/copied source trees -->
  <ItemGroup>
    <Compile Remove="obj_codex\**\*.cs;obj_codex2\**\*.cs;obj_tmp\**\*.cs;bin_codex\**\*.cs;bin_codex2\**\*.cs;bin_tmp\**\*.cs;Server\**\*.cs;Server.Tests\**\*.cs;publish\**\*.cs;artifacts\**\*.cs;.tmp_build\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="publish\**" />
    <None Remove="publish\**" />
    <Content Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

</Project>
