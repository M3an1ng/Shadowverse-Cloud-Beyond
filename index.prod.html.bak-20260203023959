                            <div class="emblem-slot"></div>
                            <div class="emblem-slot"></div>
                            <div class="emblem-slot"></div>
                        </div>
                        <div class="resources-grid">
                            <!-- PP -->
                            <div class="pp-container">
                                <div class="pp-header">
                                    <span class="pp-label">PP</span>
                                    <span class="pp-text">0 / 0</span>
                                </div>
                                <div class="pp-bar-segments" id="player1-pp-bar">
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                    <div class="pp-segment empty"></div>
                                </div>
                            </div>
                            <!-- EP -->
                            <div class="resource-box ep-box">
                                <span class="resource-label ep-label">EP</span>
                                <div class="ep-dots" id="player1-ep-dots">
                                    <div class="ep-dot"></div>
                                    <div class="ep-dot"></div>
                                </div>
                            </div>
                            <!-- SEP -->
                            <div class="resource-box sep-box">
                                <span class="resource-label sep-label">SEP</span>
                                <div class="sep-dots" id="player1-sep-dots">
                                    <div class="sep-dot"></div>
                                    <div class="sep-dot"></div>
                                </div>
                            </div>
                            <!-- Deck/Grave -->
                            <div class="resource-box deck-box">
                                <span class="resource-label">DECK</span>
                                <span class="resource-value" id="player1-deck-count">0</span>
                            </div>
                            <div class="resource-box grave-box">
                                <span class="resource-label">GRAVE</span>
                                <span class="resource-value" id="player1-grave-count">0</span>
                            </div>
                            <div class="resource-box blood-box">
                                <span class="resource-label">BLOOD</span>
                                <span class="resource-value" id="player1-blood-count">0</span>
                            </div>
                            <div class="resource-box combo-box">
                                <span class="resource-label">COMBO</span>
                                <span class="resource-value" id="player1-combo-count">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Turn Info Display -->
                <div id="turn-info" class="turn-info-display">TURN 1</div>

                <!-- Action Buttons -->
                <button id="reconnect-button" class="action-button" style="display: none;">重新连接</button>
                <button id="confirm-mulligan-button" class="action-button" style="display: none;">CONFIRM
                    MULLIGAN</button>
                <button id="spectator-toggle-view" class="action-button" style="display: none;">切换视角</button>
                <div id="pp-boost-action" class="pp-boost-action">
                    <div class="pp-boost-action-label">PP+1</div>
                    <button class="pp-boost-button" id="player1-pp-boost-button" type="button">
                        <span class="pp-boost-action-text">BOOST</span>
                        <span class="pp-boost-count" id="player1-pp-boost-count">0</span>
                    </button>
                </div>
                <button id="end-turn-button" class="action-button">
                    <span class="end-turn-surface">
                        <span class="end-turn-text">
                            <span class="end-turn-label">END TURN</span>
                            <span class="end-turn-countdown">03:00</span>
                        </span>
                        <span class="end-turn-indicator-trench indicator-trench-bottom" aria-hidden="true">
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                            <span class="end-turn-indicator-light"></span>
                        </span>
                        <span class="end-turn-sweep" aria-hidden="true"></span>
                    </span>
                </button>
            </div>
        </div>

        <!-- 卡牌编辑器页面 -->
        <div id="card-editor-page" class="page">
            <div class="page-header">
                <div class="page-header-left">
                    <button class="back-nav-btn" data-route="navigation" aria-label="Back to Home">
                        <div class="back-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="11 17 6 12 11 7"></polyline>
                                <polyline points="18 17 13 12 18 7"></polyline>
                            </svg>
                        </div>
                        <span class="back-text-art">卡牌工坊</span>
                    </button>
                </div>
            </div>
            <div id="card-editor-container">
                <!-- 卡牌编辑器内容将在这里动态加载 -->
                <div class="loading-message">正在加载编辑器...</div>
            </div>
        </div>

        <!-- 牌组编辑器页面 -->
        <div id="deck-builder-page" class="page">
            <div class="page-header">
                <div class="page-header-left">
                    <button class="back-nav-btn" data-route="navigation" aria-label="Back to Home">
                        <div class="back-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="11 17 6 12 11 7"></polyline>
                                <polyline points="18 17 13 12 18 7"></polyline>
                            </svg>
                        </div>
                        <span class="back-text-art">牌组编辑</span>
                    </button>
                </div>
            </div>
            <div id="deck-builder-container">
                <!-- 牌组编辑器内容将在这里动态加载 -->
                <div class="loading-message">正在加载编辑器...</div>
            </div>
        </div>

                <!-- 开发者工具页面 -->
        <div id="dev-tools-page" class="page">
            <div class="page-header">
                <div class="page-header-left">
                    <button class="back-nav-btn" data-route="navigation" aria-label="Back to Home">
                        <div class="back-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="11 17 6 12 11 7"></polyline>
                                <polyline points="18 17 13 12 18 7"></polyline>
                            </svg>
                        </div>
                        <span class="back-text-art">开发者工具</span>
                    </button>
                </div>
            </div>
            <div id="dev-tools-lock" class="dev-tools-lock">
                请先登录后再进入开发者工具。
            </div>
            <div id="dev-tools-container">
                <div class="dev-tools-grid">
                    <div class="tool-card tool-card-log-viewer">
                        <h3>实时日志窗口</h3>
                        <p>仅登录用户可访问</p>
                        <button id="log-open-btn" class="tool-button" type="button">打开日志窗口</button>
                    </div>
                    <div class="tool-card">
                        <h3>对战实验室</h3>
                        <p>快速配置 AI / 本地双人对战参数</p>
                        <button class="tool-button" data-route="dev-tools/match-lab" type="button">打开 Match Lab</button>
                    </div>
                    <div class="tool-card">
                        <h3>开发者控制台</h3>
                        <p>查看游戏状态和调试信息</p>
                        <button class="tool-button" onclick="window.devConsole?.toggle()">打开控制台</button>
                    </div>
                    <div class="tool-card">
                        <h3>API测试</h3>
                        <p>测试后端API接口</p>
                        <button class="tool-button" onclick="testMetadataAPI()">测试元数据API</button>
                    </div>
                    <div class="tool-card">
                        <h3>数据库查看器</h3>
                        <p>查看卡牌和能力数据</p>
                        <button class="tool-button" onclick="openDataViewer()">打开查看器</button>
                    </div>
                </div>

                <div id="log-viewer-modal" class="log-viewer-modal" aria-hidden="true">
                    <div class="log-viewer-panel" role="dialog" aria-label="实时日志窗口">
                        <div class="log-viewer-panel-header">
                            <div class="log-viewer-panel-title">实时日志窗口</div>
                            <button id="log-close-btn" class="tool-button" type="button">关闭</button>
                        </div>
                        <div id="devtools-log-viewer" class="devtools-log-viewer">
                            <div class="log-viewer-header">
                                <div></div>
                                <div class="log-viewer-actions">
                                    <button id="log-clear-btn" class="tool-button" type="button">清空</button>
                                    <button id="log-export-btn" class="tool-button" type="button">导出 JSON</button>
                                </div>
                            </div>
                            <div id="log-stream-lock" class="log-stream-lock">请先登录后再查看实时日志。</div>
                            <div class="log-viewer-controls">
                                <div class="log-levels">
                                    <label class="log-level-chip"><input type="checkbox" name="log-level" value="Verbose" checked>Verbose</label>
                                    <label class="log-level-chip"><input type="checkbox" name="log-level" value="Debug" checked>Debug</label>
                                    <label class="log-level-chip"><input type="checkbox" name="log-level" value="Information" checked>Info</label>
                                    <label class="log-level-chip"><input type="checkbox" name="log-level" value="Warning" checked>Warn</label>
                                    <label class="log-level-chip"><input type="checkbox" name="log-level" value="Error" checked>Error</label>
                                    <label class="log-level-chip"><input type="checkbox" name="log-level" value="Fatal" checked>Fatal</label>
                                </div>
                                <div class="log-search">
                                    <label for="log-search-input">关键字</label>
                                    <input id="log-search-input" class="form-input" type="text" placeholder="输入关键字过滤日志">
                                </div>
                                <label class="log-autoscroll">
                                    <input id="log-auto-scroll" type="checkbox" checked>
                                    自动滚动
                                </label>
                            </div>
                            <div id="log-stream-status" class="log-stream-status" data-tone="neutral">等待连接</div>
                            <div id="log-stream-list" class="log-stream-list" aria-live="polite"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Devtools Match Lab Page -->
        <div id="dev-tools-match-lab-page" class="page">
            <div class="page-header">
                <div class="page-header-left">
                    <button class="back-nav-btn" data-route="dev-tools" aria-label="Back to Devtools">
                        <div class="back-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="11 17 6 12 11 7"></polyline>
                                <polyline points="18 17 13 12 18 7"></polyline>
                            </svg>
                        </div>
                        <span class="back-text-art">对战实验室</span>
                    </button>
                </div>
            </div>
            <div id="dev-tools-match-lab-lock" class="dev-tools-lock" aria-hidden="true">
                请先登录后再进入对战实验室。
            </div>
            <div id="dev-tools-match-lab-container" class="match-lab-container">
                <div class="match-lab-grid">
                    <div class="match-lab-card">
                        <div class="match-lab-title">对战配置</div>
                        <div class="match-lab-field">
                            <label for="match-lab-mode">对战模式</label>
                            <select id="match-lab-mode" class="form-input">
                                <option value="ai">人机对战</option>
                                <option value="dual">本地双人</option>
                            </select>
                        </div>
                        <div class="match-lab-field">
                            <label for="match-lab-player-deck">玩家卡组</label>
                            <select id="match-lab-player-deck" class="form-input"></select>
                        </div>
                        <div class="match-lab-field">
                            <label id="match-lab-opponent-label" for="match-lab-opponent-deck">AI 卡组</label>
                            <select id="match-lab-opponent-deck" class="form-input"></select>
                        </div>
                        <div class="match-lab-note">仅登录用户可用，配置不会影响正常模式。</div>
                    </div>
                    <div class="match-lab-card">
                        <div class="match-lab-title">开局参数</div>
                        <div class="match-lab-field">
                            <label for="match-lab-start-pp">起始 PP</label>
                            <input id="match-lab-start-pp" class="form-input" type="number" min="0" max="10" placeholder="0">
                        </div>
                        <div class="match-lab-field">
                            <label for="match-lab-max-pp">最大 PP</label>
                            <input id="match-lab-max-pp" class="form-input" type="number" min="0" max="10" placeholder="0">
                        </div>
                        <div class="match-lab-field">
                            <label for="match-lab-start-hp">起始 HP</label>
                            <input id="match-lab-start-hp" class="form-input" type="number" min="1" max="20" placeholder="20">
                        </div>
                        <div class="match-lab-field">
                            <label for="match-lab-hand-size">起手数</label>
                            <input id="match-lab-hand-size" class="form-input" type="number" min="0" max="9" placeholder="4">
                        </div>
                        <div class="match-lab-field">
                            <label for="match-lab-pp-boost">PP+1 次数</label>
                            <input id="match-lab-pp-boost" class="form-input" type="number" min="0" max="5" placeholder="默认">
                        </div>
                        <div class="match-lab-field">
                            <label for="match-lab-seed">随机种子</label>
                            <input id="match-lab-seed" class="form-input" type="number" placeholder="可选">
                        </div>
                        <div class="match-lab-presets">
                            <button id="match-lab-preset-standard" class="tool-button" type="button">标准开局</button>
                            <button id="match-lab-preset-high-pp" class="tool-button" type="button">高费开局</button>
                            <button id="match-lab-preset-high-hp" class="tool-button" type="button">高血开局</button>
                        </div>
                    </div>
                </div>
                <div class="match-lab-actions">
                    <button id="match-lab-start-btn" class="tool-button" type="button">启动对战</button>
                    <div id="match-lab-status" class="match-lab-status" data-tone="neutral"></div>
                </div>
            </div>
        </div>

        <!-- DSL Editor V2 Page -->
        <div id="dsl-editor-v2-page" class="page">
            <div id="dsl-editor-v2-container"></div>
        </div>

    </div>

    <!-- (可选) 游戏结束遮罩 -->
    <!-- <div id="game-over-overlay" class="hidden">
        <h2 id="game-over-message"></h2>
        <button id="restart-button">重新开始</button>
    </div> -->
</body>

</html>




